# Copia este archivo como ".env" y escribe tu clave. El archivo .env no se sube al repositorio.

# --- Gemini (opción usada en el taller) ---
# La clave se crea en https://aistudio.google.com/apikey
LLM_API_KEY=pega_aqui_tu_clave
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODELO_LLM=gemini-3.5-flash-lite

# Segundos de espera entre llamadas, para no superar el límite por minuto del plan gratuito
PAUSA_ENTRE_LLAMADAS=4

# --- Alternativa: modelo local con Ollama (el del Taller 1) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# MODELO_LLM=llama3.2
# PAUSA_ENTRE_LLAMADAS=0

# --- Alternativa: OpenAI ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# MODELO_LLM=gpt-4o-mini

# Fecha que usa el sistema de pedidos simulado para calcular plazos (formato AAAA-MM-DD)
FECHA_REFERENCIA=2026-10-26
